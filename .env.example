# Which implementations sit behind each boundary — explicitly configured, no defaults.
MIRELLA_VCS_PROVIDER=github
MIRELLA_AGENT_HARNESS=claude-code
MIRELLA_STATE_STORE=file

# How often the orchestrator polls for new activity, in milliseconds. This is
# the base cadence; it is automatically extended (up to sleeping until the
# provider's rate-limit window resets) when API quota runs low.
MIRELLA_POLL_INTERVAL_MS=10000

# Repo whose issues you want to read
MIRELLA_REPO_OWNER=your-org
MIRELLA_REPO_NAME=your-repo

# Branch that development branches fork from (e.g. dev -> feat/...)
MIRELLA_BASE_BRANCH=dev

# GitHub App settings -> https://github.com/settings/apps (or org settings -> GitHub Apps)
GITHUB_APP_ID=123456
# App settings -> Installations, or the URL when you visit the installation page
GITHUB_INSTALLATION_ID=12345678

# Docker/compose env files take values literally: no surrounding quotes.
# Local `npm run dev` reads this same file via node's --env-file.

# Option A: path to your .pem, relative to the project root (also correct
# inside containers, where compose mounts it at /app/<name>.pem, cwd /app).
# If you rename/move the file, also update the mount in compose.yaml.
GITHUB_APP_PRIVATE_KEY_PATH=./mirella.pem

# Option B: inline key, newlines written as literal \n
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n

# Anthropic-compatible endpoint: Ollama Cloud.
# Paste your API key from https://ollama.com/settings/keys into ANTHROPIC_AUTH_TOKEN.
# (These are read by the claude-code agent harness — see src/harness/claude-code.ts.)
ANTHROPIC_BASE_URL=https://ollama.com
ANTHROPIC_AUTH_TOKEN=<token>
ANTHROPIC_MODEL=glm-5.3-flash:cloud
# Claude Code calls a small model for background tasks; map it to the same model.
ANTHROPIC_SMALL_FAST_MODEL=glm-5.3-flash:cloud