# GitHub App settings -> https://github.com/settings/apps (or org settings -> GitHub Apps)
GITHUB_APP_ID=123456
# App settings -> Installations, or the URL when you visit the installation page
GITHUB_INSTALLATION_ID=12345678

# Repo whose issues you want to read
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo

# Docker/compose env files take values literally: no surrounding quotes.
# Local `npm run dev` reads this same file via node's --env-file.

# Option A: path to your .pem, relative to the project root (also correct
# inside containers, where compose mounts it at /app/<name>.pem, cwd /app).
# If you rename/move the file, also update the mount in compose.yaml.
GITHUB_APP_PRIVATE_KEY_PATH=./mirella.pem

# Option B: inline key, newlines written as literal \n
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n